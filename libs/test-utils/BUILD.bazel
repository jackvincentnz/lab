load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("//tools/bazel:ts.bzl", "ts_project")
load("//tools/bazel/vitest:vitest.bzl", "vitest_run")

ts_project(
    name = "src",
    srcs = glob(
        ["src/*.ts*"],
        exclude = ["src/*.test.tsx"],
    ),
    deps = [
        "//:node_modules/@apollo/client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/modals",
        "//:node_modules/@testing-library/jest-dom",
        "//:node_modules/@testing-library/react",
        "//:node_modules/@testing-library/user-event",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router-dom",
        "//:node_modules/vitest",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":src",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "test_ts",
    testonly = True,
    srcs = glob(["src/*.test.tsx"]),
    deps = [
        ":src",
        "//:node_modules/@apollo/client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/modals",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router-dom",
    ],
)

# Libraries have no Vite app config, so the shared config runs from the workspace root.
vitest_run(
    name = "test",
    args = [
        "--config",
        "$(rootpath //tools/bazel/vitest:vite_config)",
    ],
    chdir = None,
    data = [
        ":test_ts",
        "//:node_modules/react-dom",
        "//tools/bazel/vitest:package_json",
        "//tools/bazel/vitest:vite_config",
    ],
)
