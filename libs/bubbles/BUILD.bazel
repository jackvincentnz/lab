load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("//tools/bazel:js.bzl", "js_library")
load("//tools/bazel:pkg.bzl", "tar")
load("//tools/bazel:ts.bzl", "ts_project")
load("//tools/bazel/oci:defs.bzl", "oci_deliver", "oci_image")
load("//tools/bazel/storybook:storybook.bzl", "storybook_build", "storybook_dev_server")
load("//tools/bazel/vitest:vitest.bzl", "vitest_run")

TEST_PATHS = [
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
]

STORY_PATHS = [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
]

ts_project(
    name = "src_ts",
    srcs = glob(
        include = [
            "src/**/*.tsx",
            "src/**/*.ts",
        ],
        exclude = TEST_PATHS + STORY_PATHS,
    ),
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/dates",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/react",
        "//:node_modules/dayjs",
        "//:node_modules/react",
        "//libs/packages/client",
    ],
)

js_library(
    name = "src",
    srcs = glob(["src/**/*.css"]),
    deps = [":src_ts"],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":src",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "test_ts",
    testonly = True,
    srcs = glob(
        TEST_PATHS,
        allow_empty = True,
    ),
    deps = [
        ":src",
        "//:node_modules/@lab/test-utils",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

# Libraries have no Vite app config, so the shared config runs from the workspace root.
vitest_run(
    name = "test",
    args = [
        "--config",
        "$(rootpath //tools/bazel/vitest:vite_config)",
    ],
    chdir = None,
    data = [
        ":test_ts",
        "//:node_modules/react-dom",
        "//tools/bazel/vitest:package_json",
        "//tools/bazel/vitest:vite_config",
    ],
)

ts_project(
    name = "stories",
    srcs = glob(STORY_PATHS),
    deps = [
        ":src",
        "//:node_modules/@storybook/react",
    ],
)

STORYBOOK_SRCS = [
    ".storybook/main.ts",
    ".storybook/preview.tsx",
]

STORYBOOK_DEPS = [
    ":stories",
    "//:node_modules/@mantine/core",
    "//:node_modules/@mantine/dates",
    "//:node_modules/@mantine/hooks",
    "//:node_modules/@tabler/icons-react",
    "//:node_modules/@storybook/react-vite",
    "//:node_modules/react",
    "//:node_modules/react-dom",
    "//:node_modules/storybook",
    "//:node_modules/vite",
]

storybook_build(
    name = "build_storybook",
    srcs = STORYBOOK_SRCS + STORYBOOK_DEPS,
)

storybook_dev_server(
    name = "storybook",
    data = STORYBOOK_SRCS + STORYBOOK_DEPS,
)

tar(
    name = "tar",
    srcs = [":build_storybook"],
    package_dir = "/usr/share/nginx/html",
    strip_prefix = "storybook-static",
)

oci_image(
    name = "image",
    base = "@nginx_alpine_slim",
    tars = [":tar"],
)

oci_deliver(
    name = "deliver",
    image = ":image",
    repo_suffix = "bubbles",
)
