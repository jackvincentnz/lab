{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch -q origin)",
      "Bash(git fetch origin --quiet)",
      "Bash(git fetch origin main)",
      "Bash(git fetch -q origin main)",
      "Bash(git fetch origin main --quiet)",
      "Bash(bazel info *)",
      "Bash(docker info)"
    ]
  }
}
