{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^projects/organizer/e2e/runner\\.ts$/"],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io/apollographql/router):(?<currentValue>v?[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Confluent images used outside Compose manifests",
      "managerFilePatterns": [
        "/^projects/organizer/e2e/runner\\.ts$/",
        "/^learn/testcontainers/src/test/java/lab/learn/testcontainers/kafka/KafkaTest\\.java$/"
      ],
      "matchStrings": [
        "(?<depName>confluentinc/cp-(?:kafka|schema-registry)):(?<currentValue>[A-Za-z0-9_.-]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update rules_jvm_external BOMs in MODULE.bazel",
      "managerFilePatterns": ["/(^|/)MODULE\\.bazel$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "boms\\s*=\\s*\\[(?<bomBlock>[\\s\\S]*?)\\]",
        "\"(?<depName>[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+):(?<currentValue>[^\"\\s]+)\""
      ],
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Keep the Playwright browser repository aligned with @playwright/test",
      "managerFilePatterns": ["/(^|/)MODULE\\.bazel$/"],
      "matchStrings": [
        "playwright_version\\s*=\\s*\\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "depNameTemplate": "@playwright/test",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^jackvincent\\/lab-/"],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["protobuf", "com.google.protobuf:protobuf-bom"],
      "groupName": "protobuf",
      "groupSlug": "protobuf",
      "separateMajorMinor": false
    },
    {
      "description": "Keep GitHub Action and reusable workflow updates together",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependency updates",
      "groupSlug": "all-non-major-updates",
      "schedule": "* * * * 0,6",
      "matchPackageNames": [
        "!@playwright/test",
        "!protobuf",
        "!com.google.protobuf:protobuf-bom"
      ]
    },
    {
      "description": "Keep Confluent Platform images and the Java Protobuf serializer on the same release line",
      "matchPackageNames": [
        "confluentinc/cp-*",
        "io.confluent:kafka-protobuf-serializer"
      ],
      "groupName": "Confluent Platform",
      "groupSlug": "confluent-platform",
      "separateMajorMinor": false
    }
  ]
}
