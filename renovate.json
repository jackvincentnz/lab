{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update digest-pinned Docker images in source files",
      "managerFilePatterns": ["{projects,learn,libs}/**/*.{java,ts}"],
      "matchStrings": [
        "[\"'](?<depName>[a-z0-9][a-z0-9._:/-]*):(?<currentValue>[A-Za-z0-9_.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Maven BOMs",
      "managerFilePatterns": ["/(^|/)MODULE\\.bazel$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "boms\\s*=\\s*\\[(?<bomBlock>[\\s\\S]*?)\\]",
        "\"(?<depName>[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+):(?<currentValue>[^\"\\s]+)\""
      ],
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Update multitool binaries",
      "managerFilePatterns": ["/^tools/tools\\.lock\\.json$/"],
      "matchStrings": [
        "\"url\"\\s*:\\s*\"https://github\\.com/(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/releases/download/(?<currentValue>v[^/\"\\s]+)/[^\"\\s]+\",\\s*\"sha256\"\\s*:\\s*\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{#if newDigest}}{{#if (equals currentDigest newDigest)}}{{{replaceString}}}{{else}}{{{replace currentDigest newDigest (replace currentValue newValue replaceString)}}}{{/if}}{{else}}{{{replaceString}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update OpenTelemetry Java agent",
      "managerFilePatterns": ["/^MODULE\\.bazel$/"],
      "matchStrings": [
        "http_jar\\(\\s*name\\s*=\\s*\"opentelemetry-javaagent\",\\s*sha256\\s*=\\s*\"(?<currentDigest>[a-f0-9]{64})\",\\s*url\\s*=\\s*\"https://github\\.com/(?<depName>open-telemetry/opentelemetry-java-instrumentation)/releases/download/(?<currentValue>v[^/\"\\s]+)/opentelemetry-javaagent\\.jar\",\\s*\\)"
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{#if newDigest}}{{#if (equals currentDigest newDigest)}}{{{replaceString}}}{{else}}{{{replace currentDigest newDigest (replace currentValue newValue replaceString)}}}{{/if}}{{else}}{{{replaceString}}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^jackvincent\\/lab-/"],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["protobuf", "com.google.protobuf:protobuf-bom"],
      "groupName": "protobuf",
      "groupSlug": "protobuf",
      "separateMajorMinor": false
    },
    {
      "description": "Update GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependency updates",
      "groupSlug": "all-non-major-updates",
      "schedule": "* * * * 0,6",
      "matchPackageNames": [
        "!protobuf",
        "!com.google.protobuf:protobuf-bom",
        "!@playwright/test"
      ]
    },
    {
      "description": "Update Confluent Platform",
      "matchPackageNames": [
        "confluentinc/cp-*",
        "io.confluent:kafka-protobuf-serializer"
      ],
      "groupName": "Confluent Platform",
      "groupSlug": "confluent-platform",
      "separateMajorMinor": false
    }
  ]
}
