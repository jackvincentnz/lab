load("//tools/bazel:js.bzl", "js_binary", "js_library", "js_test")

js_library(
    name = "report_lib",
    srcs = ["report.js"],
    deps = ["//:node_modules/prettier"],
)

js_binary(
    name = "report",
    data = [
        "cli.js",
        "inventory.json",
        ":report_lib",
    ],
    entry_point = "cli.js",
)

js_test(
    name = "report_test",
    data = [
        "cli.js",
        "inventory.json",
        "report.test.js",
        ":report_lib",
    ],
    entry_point = "report.test.js",
    node_options = ["--test"],
)
