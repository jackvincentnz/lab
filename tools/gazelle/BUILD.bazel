load("@aspect_gazelle_prebuilt//:def.bzl", "aspect_gazelle")
load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@rules_multirun//:defs.bzl", "multirun")

# Updates BUILD files with both generators.
multirun(
    name = "gazelle",
    commands = [
        ":java",
        ":js",
    ],
    print_command = False,
)

# Prints what each generator would change, and fails when either would change anything. Aspect's
# runner exits 0 when `-mode=diff` is passed on the command line, so CI runs this target instead.
multirun(
    name = "check",
    commands = [
        ":java.check",
        ":js.check",
    ],
    keep_going = True,
    print_command = False,
)

gazelle_binary(
    name = "gazelle_bin",
    languages = ["@contrib_rules_jvm//java/gazelle"],
)

_JAVA_ARGS = [
    # Test classes annotated @RequiresDocker get their own target, so runners without Docker can
    # filter them out by tag.
    '-java-annotation-to-attribute=lab.test.RequiresDocker=tags=["requires-docker","requires-network"]',
]

gazelle(
    name = "java",
    args = _JAVA_ARGS,
    gazelle = ":gazelle_bin",
)

gazelle(
    name = "java.check",
    args = _JAVA_ARGS,
    gazelle = ":gazelle_bin",
    mode = "diff",
)

# Aspect's prebuilt runner ships the JS/TS language compiled, but not Java.
aspect_gazelle(
    name = "js",
    languages = ["js"],
    with_check = True,
)
