load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

config_setting(
    name = "coverage_enabled",
    values = {"collect_code_coverage": "true"},
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "docs",
    srcs = ["docs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@aspect_bazel_lib//lib:write_source_files",
        "@stardoc//stardoc:stardoc_lib",
    ],
)

bzl_library(
    name = "fe",
    srcs = ["fe.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":js",
        ":ts",
        "//tools/bazel/vite",
        "//tools/bazel/vitest",
    ],
)

bzl_library(
    name = "graphql",
    srcs = ["graphql.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":ts",
        "@npm//:@graphql-codegen/cli_bzl_library",
    ],
)

bzl_library(
    name = "java",
    srcs = ["java.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        # contrib_rules_jvm loads this but omits it from its Starlark deps.
        "@bazel_skylib//rules:run_binary",
        "@contrib_rules_jvm//java:defs",
        "@rules_java//java:rules",
    ],
)

bzl_library(
    name = "js",
    srcs = ["js.bzl"],
    visibility = ["//visibility:public"],
    deps = ["@aspect_rules_js//js:defs"],
)

bzl_library(
    name = "pkg",
    srcs = ["pkg.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@rules_pkg//:pkg.bzl",
        "@rules_pkg//pkg:rules_pkg_lib",
    ],
)

bzl_library(
    name = "ts",
    srcs = ["ts.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@aspect_rules_swc//swc:defs",
        "@aspect_rules_ts//ts:defs",
        "@bazel_skylib//lib:partial",
    ],
)

exports_files(glob(["*.bzl"]))
