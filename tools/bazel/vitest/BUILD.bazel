load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@npm//:vitest/package_json.bzl", vitest_bin = "bin")
load("//tools/bazel:js.bzl", "js_library")

package(default_visibility = ["//visibility:public"])

vitest_bin.vitest_binary(
    name = "vitest_binary",
)

js_library(
    name = "vite_config",
    srcs = ["vite.config.ts"],
    deps = [":test_config"],
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

js_library(
    name = "test_config",
    srcs = [
        "config.ts",
        "coverage.ts",
    ],
    deps = [
        "//:node_modules/@lab/test-utils",
        "//:node_modules/@vitest/coverage-v8",
        "//:node_modules/jsdom",
        "//:node_modules/vitest",
    ],
)

bzl_library(
    name = "vitest",
    srcs = ["vitest.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//tools/bazel:js",
        "@npm//:vitest_bzl_library",
    ],
)

exports_files(["vitest.bzl"])
