load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@npm//:vitest/package_json.bzl", vitest_bin = "bin")
load("//tools/bazel:js.bzl", "js_library", "npm_package")
load("//tools/bazel:ts.bzl", "node_ts_project")

package(default_visibility = ["//visibility:public"])

vitest_bin.vitest_binary(
    name = "vitest_binary",
)

js_library(
    name = "vite_config",
    srcs = ["vite.config.ts"],
    deps = [
        ":config_ts",
        ":test_config",
    ],
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

node_ts_project(
    name = "config_ts",
    srcs = [
        "config.ts",
        "coverage.ts",
    ],
    deps = ["//:node_modules/vitest"],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":config_ts",
    ],
)

# Vitest resolves the setup file, environment and coverage provider that the config names from
# the app's root, so link them in the root `node_modules` with the config package.
js_library(
    name = "test_config",
    # Vite ends its workspace-root search at this file, so `server.fs.allow` covers shared setup.
    data = ["//:pnpm_workspace"],
    deps = [
        "//:node_modules/@lab/test-utils",
        "//:node_modules/@lab/vitest-config",
        "//:node_modules/@vitest/coverage-v8",
        "//:node_modules/jsdom",
        "//:node_modules/vitest",
    ],
)

bzl_library(
    name = "vitest",
    srcs = ["vitest.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//tools/bazel:js",
        "@npm//:vitest_bzl_library",
    ],
)

exports_files(["vitest.bzl"])
