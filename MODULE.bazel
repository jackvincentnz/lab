module(name = "lab")

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.10.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "aspect_rules_swc", version = "2.7.6")
bazel_dep(name = "rules_playwright", version = "0.0.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "rules_spring", version = "2.6.3")
bazel_dep(name = "rules_multitool", version = "1.11.1")
bazel_dep(name = "bazel_env.bzl", version = "0.10.0")

bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True)
bazel_dep(name = "rules_go", version = "0.65.0", dev_dependency = True)

# rules_go's go.mod requires Go 1.25 and builds with 1.26.7; select that toolchain
# ahead of contrib_rules_jvm's older SDK.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.26.7")

# 0.34.0 deadlocks the JUnit 5 runner's hostname lookup, so every Java test waits 5 seconds after
# its last test. The patch backports bazel-contrib/rules_jvm#499. Setting no version keeps Renovate
# proposing releases; the first release with the fix makes the patch fail to apply. See #1143 for
# how to remove this override then.
single_version_override(
    module_name = "contrib_rules_jvm",
    patch_strip = 1,
    patches = ["//third_party/contrib_rules_jvm:hostname-deadlock.patch"],
)

git_override(
    module_name = "rules_playwright",
    commit = "bf4a6acf00321e30df612e4af8ef900f51bc4fe3",
    remote = "https://github.com/mrmeku/rules_playwright.git",
)

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:tools.lock.json")
use_repo(multitool, "multitool")

http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_jar(
    name = "opentelemetry-javaagent",
    sha256 = "e43a270df53c6f423e0ab157be9c27ccc01d5dc3232e162fe54777573db2f149",
    url = "https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.33.1/opentelemetry-javaagent.jar",
)

####################################################################################################
# aspect_bazel_lib setup
####################################################################################################

bazel_lib_toolchains = use_extension("@aspect_bazel_lib//lib:extensions.bzl", "toolchains")
use_repo(bazel_lib_toolchains, "jq_toolchains")

####################################################################################################
# maven setup
####################################################################################################

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# Maven lock file will need to be updated whenever the artifacts or repositories change.
# See: https://github.com/bazelbuild/rules_jvm_external#requiring-lock-file-repinning-when-the-list-of-artifacts-changes
# To re-pin everything, run:
# REPIN=1 bazel run @maven//:pin
maven.install(
    artifacts = [
        "com.fasterxml.jackson.module:jackson-module-parameter-names",  # DGS client directly registers this Jackson 2 module; remove when DGS no longer needs it.
        "com.h2database:h2",
        "com.jayway.jsonpath:json-path:3.0.0",
        "com.mysql:mysql-connector-j",
        "org.apache.commons:commons-lang3",
        "org.apache.kafka:kafka-clients",
        "org.apache.kafka:kafka-metadata",
        "org.apache.kafka:kafka-raft",
        "org.apache.kafka:kafka-server-common",
        "org.apache.kafka:kafka-storage",
        "org.apache.kafka:kafka-storage-api",
        "org.apache.kafka:kafka-streams",
        "org.apache.kafka:kafka-streams-test-utils",
        "org.apache.kafka:kafka_2.13",
        "org.eclipse.jetty:jetty-reactive-httpclient",
        "org.flywaydb:flyway-database-postgresql",
        "org.springframework.boot:spring-boot-starter-flyway",
        "org.springframework.ai:spring-ai-starter-mcp-server-webmvc",
        "org.springframework.ai:spring-ai-starter-model-google-genai",
        "org.springframework.ai:spring-ai-starter-model-ollama",
        "org.springframework.ai:spring-ai-starter-model-openai",
        "org.springframework.boot:spring-boot-docker-compose",
        "org.springframework.boot:spring-boot-loader",
        "org.springframework.boot:spring-boot-starter-actuator",
        "org.springframework.boot:spring-boot-starter-data-jdbc",
        "org.springframework.boot:spring-boot-starter-oauth2-resource-server",
        "org.springframework.boot:spring-boot-starter-kafka",
        "org.springframework.boot:spring-boot-starter-security",
        "org.springframework.boot:spring-boot-starter-session-data-redis",
        "org.springframework.boot:spring-boot-starter-validation",
        "org.springframework.boot:spring-boot-starter-web",
        "org.springframework.boot:spring-boot-starter-webflux",
        "org.springframework.cloud:spring-cloud-starter-gateway-server-webflux",
        "org.springframework.session:spring-session-data-redis",
        "redis.clients:jedis",
        "org.postgresql:postgresql:42.7.14",
        "org.springframework.boot:spring-boot-starter-test",
        "org.springframework.kafka:spring-kafka-test",
        "org.testcontainers:testcontainers",
        "org.testcontainers:testcontainers-jdbc",
        "org.testcontainers:testcontainers-junit-jupiter",
        "org.testcontainers:testcontainers-kafka",
        "org.testcontainers:testcontainers-postgresql",
        "org.junit.platform:junit-platform-launcher",
        "org.junit.platform:junit-platform-reporting",
        "com.netflix.graphql.dgs:dgs-starter",
        "com.netflix.graphql.dgs:dgs-starter-test",
        "com.netflix.graphql.dgs:graphql-dgs-extended-scalars",
        "jakarta.servlet:jakarta.servlet-api",
        "io.confluent:kafka-protobuf-serializer:8.3.2",
        "com.netflix.graphql.dgs.codegen:graphql-dgs-codegen-core:8.7.0",
        "com.github.ajalt.clikt:clikt-jvm:4.4.0",  # explicitly depend on the jvm version rather than the kotlin one linked from com.netflix.graphql.dgs.codegen:graphql-dgs-codegen-core, at the 4.4.0 it declares; Clikt 5 changed the CliktCommand constructor, so codegen fails with NoSuchMethodError
        "com.squareup.okhttp3:okhttp-jvm:5.5.1",
        "org.apache.tomcat.embed:tomcat-embed-core:11.0.27",
        "org.apache.tomcat.embed:tomcat-embed-el:11.0.27",
        "org.apache.tomcat.embed:tomcat-embed-websocket:11.0.27",
    ],
    boms = [
        # First wins
        "io.netty:netty-bom:4.2.20.Final",
        "com.google.protobuf:protobuf-bom:4.36.2",
        "org.springframework.boot:spring-boot-dependencies:4.1.2",
        "org.springframework.cloud:spring-cloud-dependencies:2025.1.4",
        "org.springframework.ai:spring-ai-bom:2.0.2",
        "com.netflix.graphql.dgs:graphql-dgs-platform-dependencies:12.1.0",
        "org.testcontainers:testcontainers-bom:2.0.5",
    ],
    fail_if_repin_required = True,
    fetch_sources = True,
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://packages.confluent.io/maven",
    ],
)
maven.override(
    # bazel resolves kotlin artifact rather than jvm one which doesn't contain expected classes for gql codegen
    coordinates = "com.github.ajalt.clikt:clikt",
    target = "@maven//:com_github_ajalt_clikt_clikt_jvm",
)
use_repo(
    maven,
    "maven",
)

####################################################################################################
# rules_nodejs setup
####################################################################################################

node = use_extension(
    "@rules_nodejs//nodejs:extensions.bzl",
    "node",
    dev_dependency = True,
)
node.toolchain(
    # Without node_repositories, rules_nodejs records the release checksums in MODULE.bazel.lock.
    node_version_from_nvmrc = "//:.nvmrc",
)

####################################################################################################
# aspect_rules_js setup
####################################################################################################

npm = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "npm",
    dev_dependency = True,
)
npm.npm_translate_lock(
    name = "npm",
    # Stardoc needs the Starlark libraries generated for npm binary macros.
    generate_bzl_library_targets = True,
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    pnpm_version_from = "//:package.json",
)

# Allows developers to use the matching pnpm version, for example:
# bazel run -- @pnpm --dir /home/runner/work/rules_js/rules_js install
use_repo(pnpm, "pnpm")

####################################################################################################
# aspect_rules_ts setup
####################################################################################################

rules_ts_ext = use_extension(
    "@aspect_rules_ts//ts:extensions.bzl",
    "typescript",
    dev_dependency = True,
)
rules_ts_ext.deps(
    version_from = "//:package.json",
)
use_repo(rules_ts_ext, "npm_typescript")

####################################################################################################
# aspect_rules_swc setup
####################################################################################################

swc = use_extension(
    "@aspect_rules_swc//swc:extensions.bzl",
    "swc",
    dev_dependency = True,
)

# The SWC that rules_swc defaults to rejects the es2023 target, so use the @swc/core version in package.json.
swc.toolchain(
    name = "swc",
    swc_version_from = "//:package.json",
)

####################################################################################################
# rules_playwright setup
####################################################################################################

playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    browsers_download_urls = [
        "https://cdn.playwright.dev/dbazure/download/playwright",
        "https://playwright.download.prss.microsoft.com/dbazure/download/playwright",
        "https://cdn.playwright.dev",
    ],
    # Keep aligned with @playwright/test in package.json.
    playwright_version = "1.56.1",
)
use_repo(playwright, "playwright")

####################################################################################################
# rules_oci setup
####################################################################################################

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_java",
    digest = "sha256:21584711fb3e25745d442add41f2bb18f84f74e2650033fdcf6d81707e925c11",
    image = "gcr.io/distroless/java17-debian13",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "latest",
)
oci.pull(
    name = "nginx_alpine_slim",
    digest = "sha256:4c734d33ee731135dc9f2349914a34551c920f4451fca8bb05bf5880eb9079e8",
    image = "nginx",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "1.31.8-alpine-slim",
)
oci.toolchains(name = "lab_oci")
use_repo(oci, "distroless_java", "distroless_java_linux_amd64", "distroless_java_linux_arm64_v8", "lab_oci_crane_toolchains", "lab_oci_regctl_toolchains", "nginx_alpine_slim", "nginx_alpine_slim_linux_amd64", "nginx_alpine_slim_linux_arm64_v8")
