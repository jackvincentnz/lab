load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/bazel:fe.bzl", "fe_app")
load("//tools/bazel:js.bzl", "js_library")
load("//tools/bazel:pkg.bzl", "tar")
load("//tools/bazel:ts.bzl", "ts_project")
load("//tools/bazel/oci:defs.bzl", "oci_deliver", "oci_image")

# aspect:js enabled
# aspect:generation_mode update_only
# aspect:js_files src/**/*.{ts,tsx}
# aspect:js_test_files src/**/*.{test,spec}.{ts,tsx}
# aspect:js_test_files src/test/**/*.{ts,tsx}
# aspect:js_project_naming_convention src
# aspect:js_tests_naming_convention tests
# aspect:js_resolve **/__generated__/graphql //projects/mops/app/src/__generated__:graphql_codegen_ts
# gazelle:exclude public

js_library(
    name = "codegen",
    srcs = ["codegen.ts"],
    visibility = ["//projects/mops/app/src/__generated__:__pkg__"],
    deps = ["//tools/bazel/graphql:codegen_config"],
)

js_library(
    name = "gql",
    srcs = glob(["src/**/*.gql"]),
    visibility = ["//projects/mops/app/src/__generated__:__pkg__"],
)

fe_app(
    name = "app",
    srcs = [":src"],
    data = [
        "index.html",
        "package.json",
        "postcss.config.cjs",
        "vite.config.ts",
        "//:node_modules/postcss-preset-mantine",
        "//:node_modules/postcss-simple-vars",
        "//:node_modules/vite",
        "//:node_modules/vitest",
        "//projects/mops/app/public",
        "//tools/bazel/vitest:coverage_config",
    ],
    test_tags = ["exclusive"],
    tests = [":tests"],
    visibility = ["//projects/mops:__pkg__"],
)

tar(
    name = "tar",
    srcs = [":build"],
    package_dir = "/usr/share/nginx/html/",
    strip_prefix = "dist",
)

tar(
    name = "nginx_conf_tar",
    srcs = ["default.conf.template"],
    package_dir = "/etc/nginx/templates",
)

oci_image(
    name = "image",
    base = "@nginx_alpine_slim",
    tars = [
        ":tar",
        ":nginx_conf_tar",
    ],
)

oci_deliver(
    name = "deliver",
    image = ":image",
    repo_suffix = "mops-app",
    visibility = ["//projects/mops/e2e:__pkg__"],
)

npm_link_all_packages(name = "node_modules")

