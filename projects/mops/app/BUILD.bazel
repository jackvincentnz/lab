load("//tools/bazel:fe.bzl", "fe_app")
load("//tools/bazel:js.bzl", "js_library")
load("//tools/bazel:pkg.bzl", "tar")
load("//tools/bazel/oci:defs.bzl", "oci_deliver", "oci_image")

js_library(
    name = "codegen",
    srcs = ["codegen.ts"],
    visibility = ["//projects/mops/app/src/__generated__:__pkg__"],
)

js_library(
    name = "gql",
    srcs = glob(["src/**/*.gql"]),
    visibility = ["//projects/mops/app/src/__generated__:__pkg__"],
)

fe_app(
    name = "app",
    assets = glob([
        "src/**/*.css",
        "src/**/*.png",
    ]),
    data = [
        "index.html",
        "package.json",
        "postcss.config.cjs",
        "vite.config.ts",
        "//:node_modules/postcss-preset-mantine",
        "//:node_modules/postcss-simple-vars",
        "//:node_modules/vitest",
        "//projects/mops/app/public",
        "//tools/bazel/vitest:coverage_config",
    ],
    test_deps = [
        "//:node_modules/@testing-library/jest-dom",
        "//:node_modules/@testing-library/react",
        "//:node_modules/@testing-library/user-event",
        "//:node_modules/vitest",
    ],
    test_tags = ["exclusive"],
    visibility = ["//projects/mops:__pkg__"],
    deps = [
        "//:node_modules/@apollo/client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@mantine/modals",
        "//:node_modules/@statsig/react-bindings",
        "//:node_modules/@statsig/session-replay",
        "//:node_modules/@statsig/web-analytics",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/clsx",
        "//:node_modules/dayjs",
        "//:node_modules/graphql-ws",
        "//:node_modules/mantine-datatable",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/react-markdown",
        "//:node_modules/react-router-dom",
        "//:node_modules/remark-gfm",
        "//:node_modules/vite",
        "//projects/mops/app/src/__generated__:graphql_codegen_ts",
    ],
)

tar(
    name = "tar",
    srcs = [":build"],
    package_dir = "/usr/share/nginx/html/",
    strip_prefix = "dist",
)

tar(
    name = "nginx_conf_tar",
    srcs = ["default.conf.template"],
    package_dir = "/etc/nginx/templates",
)

oci_image(
    name = "image",
    base = "@nginx_alpine_slim",
    tars = [
        ":tar",
        ":nginx_conf_tar",
    ],
)

oci_deliver(
    name = "deliver",
    image = ":image",
    repo_suffix = "mops-app",
    visibility = ["//projects/mops/e2e:__pkg__"],
)
