load("//tools/bazel:js.bzl", "js_run_devserver")

DESKTOP_APP_DATA = [
    "//projects/day/app:build",
    "//projects/day/desktop",
    "//projects/day/service:src",
]

js_run_devserver(
    name = "day",
    args = ["projects/day/desktop/src/main.js"],
    data = DESKTOP_APP_DATA,
    env = {"DAY_PROFILE": "dev"},
    tool = "//tools/bazel/electron:electron_binary",
)

js_run_devserver(
    name = "prod",
    args = ["projects/day/desktop/src/main.js"],
    data = DESKTOP_APP_DATA,
    tool = "//tools/bazel/electron:electron_binary",
)
