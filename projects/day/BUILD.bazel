load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools/bazel:js.bzl", "js_binary", "js_library", "js_run_binary", "js_run_devserver")
load("//tools/bazel:ts.bzl", "node_ts_project")

DESKTOP_APP_DATA = [
    "//projects/day/app:build",
    "//projects/day/desktop",
    "//projects/day/service:src",
]

js_run_devserver(
    name = "day",
    args = ["projects/day/desktop/src/main.js"],
    data = DESKTOP_APP_DATA,
    env = {"DAY_PROFILE": "dev"},
    tool = "//tools/bazel/electron:electron_binary",
)

js_run_devserver(
    name = "prod",
    args = ["projects/day/desktop/src/main.js"],
    data = DESKTOP_APP_DATA,
    tool = "//tools/bazel/electron:electron_binary",
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

js_run_binary(
    name = "bundle",
    srcs = [
        "vite.config.ts",
        ":package_json",
        "//:node_modules/vite",
        "//projects/day/desktop",
        "//projects/day/service:src",
    ],
    args = ["build"],
    chdir = package_name(),
    mnemonic = "ViteBuild",
    out_dirs = ["bundle"],
    tool = "//tools/bazel/vite:vite_binary",
)

copy_to_directory(
    name = "app_dir",
    srcs = [
        "package.json",
        ":bundle",
        "//projects/day/app:build",
    ],
    replace_prefixes = {"bundle/": ""},
)

node_ts_project(
    name = "mac_app_ts",
    srcs = ["mac_app.ts"],
    deps = ["//:node_modules/@electron/packager"],
)

js_binary(
    name = "mac_app_packager",
    data = [
        ":mac_app_ts",
        ":package_json",
    ],
    entry_point = "mac_app.js",
)

js_run_binary(
    name = "mac_app",
    srcs = [
        ":app_dir",
        "//:node_modules/electron/dir",
    ],
    args = [
        "$(rootpath :app_dir)",
        "$(rootpath //:node_modules/electron/dir)",
        "%s/Day.app" % package_name(),
    ],
    mnemonic = "ElectronPackager",
    out_dirs = ["Day.app"],
    # The sandbox links each file of the Electron package on its own, which loses the symlinks
    # inside Electron.app that its signature covers.
    tags = ["no-sandbox"],
    target_compatible_with = ["@platforms//os:macos"],
    tool = ":mac_app_packager",
)

sh_binary(
    name = "install",
    srcs = ["install.sh"],
    args = ["$(rootpath :mac_app)"],
    data = [":mac_app"],
)
