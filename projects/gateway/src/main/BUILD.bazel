load("//tools/bazel:java.bzl", "java_binary", "java_library")

java_library(
    name = "main_lib",
    resources = glob(["resources/**"]),
    visibility = [
        "//projects/gateway/src/test:__subpackages__",
    ],
    runtime_deps = [
        "//projects/gateway/src/main/java/lab/gateway",
        "@maven//:org_springframework_boot_spring_boot_starter_actuator",
        "@maven//:org_springframework_boot_spring_boot_starter_security",
        "@maven//:org_springframework_boot_spring_boot_starter_session_data_redis",
        "@maven//:org_springframework_cloud_spring_cloud_starter_gateway_server_webflux",
    ],
)

# Spring Boot starts and stops Redis from compose.yaml around the local run. The compose
# dependency stays on this run target so a delivered image never carries it.
java_binary(
    name = "main",
    data = ["//projects/gateway:compose.yaml"],
    env = {"SPRING_PROFILES_ACTIVE": "local"},
    jvm_flags = [
        "-Dspring.docker.compose.file=$$JAVA_RUNFILES/$(rlocationpath //projects/gateway:compose.yaml)",
    ],
    main_class = "lab.gateway.GatewayApplication",
    visibility = [
        "//projects/gateway:__pkg__",
    ],
    runtime_deps = [
        ":main_lib",
        "@maven//:org_springframework_boot_spring_boot_docker_compose",
    ],
)
