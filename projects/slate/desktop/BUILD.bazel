load("//tools/bazel:js.bzl", "js_library")
load("//tools/bazel:ts.bzl", "node_ts_project")
load("//tools/bazel/vitest:vitest.bzl", "vitest_run")

TEST_SRCS = ["src/**/*.test.ts"]

node_ts_project(
    name = "src_ts",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = TEST_SRCS,
    ),
    deps = [
        "//:node_modules/electron",
        "//:node_modules/zod",
        "//projects/slate/service:src",
    ],
)

js_library(
    name = "desktop",
    srcs = [
        "package.json",
        "//projects/slate/icons:dock",
        "//projects/slate/icons:menu_bar",
    ],
    visibility = ["//projects/slate:__pkg__"],
    deps = [":src_ts"],
)

node_ts_project(
    name = "test_ts",
    testonly = True,
    srcs = glob(TEST_SRCS),
    deps = [
        ":desktop",
        "//:node_modules/vitest",
    ],
)

vitest_run(
    name = "test",
    data = [
        "vite.config.ts",
        ":test_ts",
        "//:node_modules/vitest",
        "//tools/bazel/vitest:test_config",
    ],
)
