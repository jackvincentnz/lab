load("//tools/bazel:drizzle.bzl", "drizzle_generate")
load("//tools/bazel:js.bzl", "js_binary", "js_info_files", "js_library")
load("//tools/bazel:ts.bzl", "node_ts_project")
load("//tools/bazel/vitest:vitest.bzl", "vitest_run")

TEST_SRCS = ["src/**/*.test.ts"]

SRC_DEPS = [
    "//:node_modules/@modelcontextprotocol/sdk",
    "//:node_modules/@trpc/server",
    "//:node_modules/drizzle-orm",
    "//:node_modules/fractional-indexing",
    "//:node_modules/zod",
]

node_ts_project(
    name = "src_ts",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = TEST_SRCS,
    ),
    deps = SRC_DEPS,
)

# Declarations only, so that the web UI neither bundles nor rebuilds for service
# code.
js_info_files(
    name = "declarations",
    srcs = [":src_ts"],
    include_npm_sources = False,
    include_sources = False,
    include_transitive_sources = False,
    include_transitive_types = True,
)

js_library(
    name = "types",
    types = [":declarations"],
    visibility = ["//projects/slate/app:__pkg__"],
    # node_ts_project adds @types/node to src_ts.
    deps = SRC_DEPS + ["//:node_modules/@types/node"],
)

filegroup(
    name = "migrations",
    srcs = glob(["migrations/**"]),
    visibility = ["//projects/slate:__pkg__"],
)

js_library(
    name = "src",
    srcs = [
        "package.json",
        ":migrations",
    ],
    visibility = [
        "//projects/slate:__pkg__",
        "//projects/slate/desktop:__pkg__",
    ],
    deps = [":src_ts"],
)

js_binary(
    name = "service",
    data = [":src"],
    entry_point = "src/main.js",
    env = {"SLATE_PROFILE": "dev"},
)

drizzle_generate(
    name = "generate_migration",
    data = [
        "drizzle.config.ts",
        ":src",
    ],
)

node_ts_project(
    name = "test_ts",
    testonly = True,
    srcs = glob(TEST_SRCS),
    deps = [
        ":src",
        "//:node_modules/@modelcontextprotocol/sdk",
        "//:node_modules/fractional-indexing",
        "//:node_modules/vitest",
    ],
)

vitest_run(
    name = "test",
    data = [
        "vite.config.ts",
        ":test_ts",
        "//:node_modules/vitest",
        "//tools/bazel/vitest:test_config",
    ],
    # The server test listens on a loopback port.
    tags = ["requires-network"],
)
